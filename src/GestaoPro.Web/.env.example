# Copie para .env (nao versionado) e ajuste se precisar.

# Destino do proxy do `npm run dev` para /api e /notificacaoHub.
# Padrao: http://localhost:5088 (API local). Use a URL do Render so se quiser
# testar o painel contra a API de producao.
# VITE_API_PROXY_TARGET=http://localhost:5088

# URL da API usada pelo build de producao (`npm run build`). Em dev fica vazia
# e as chamadas passam pelo proxy acima.
# VITE_API_BASE_URL=https://gestaopro-api-demo.onrender.com
