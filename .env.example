# Configuração LOCAL usada pelo iniciar.bat (copiada para .env, que fica fora do Git).
# O iniciar.bat troca os valores "gerar" por segredos fortes aleatórios na primeira execução.
# Nunca coloque aqui a string de conexão de um banco real: este arquivo é para o MongoDB local do compose.yaml.

# Banco local (container do compose.yaml, porta 27117 para não conflitar com outro MongoDB da máquina)
MongoDbSettings__ConnectionString=mongodb://localhost:27117
MongoDbSettings__DatabaseName=GestaoProLocal

# Assinatura dos tokens JWT (mínimo 32 caracteres)
JwtSettings__SecretKey=gerar

# Modo demonstração: cria o condomínio e as contas demo (síndico, morador, porteiro) e libera GET /api/demo
Demo__Enabled=true
Demo__CodigoCondominio=gerar
